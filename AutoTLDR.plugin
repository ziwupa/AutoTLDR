        "collecting_chat": "⏳ <b>Собираю последние сообщения чата...</b>",
        "analyzing": "⏳ <b>Анализирую {count} сообщений {name}...</b>",
        "analyzing_chat": "⏳ <b>Анализирую {count} сообщений чата...</b>",
        "header_user": "🧠 <b>Разбор {name}</b> <i>(по {count} сообщ.)</i>\n\n",
